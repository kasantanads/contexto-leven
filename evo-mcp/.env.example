# Copie este arquivo para ".env" e preencha VOCÊ MESMA. Nunca cole estes valores no chat.
#
# Uma credencial por unidade do EVO (cada filial tem o seu DNS e a sua Secret Key).
#   EVO_UNIT_<ROTULO>_USER = DNS da filial (usuário do Basic Authentication)
#   EVO_UNIT_<ROTULO>_KEY  = Secret Key da filial
# <ROTULO> é um nome curto que você escolhe, só letras e números (ex.: UMI). É o que se usa em "unit".
EVO_UNIT_UMI_USER=
EVO_UNIT_UMI_KEY=
EVO_UNIT_UMP_USER=
EVO_UNIT_UMP_KEY=
EVO_UNIT_UCB_USER=
EVO_UNIT_UCB_KEY=
EVO_UNIT_UP_USER=
EVO_UNIT_UP_KEY=

# Política de acesso (padrão: somente leitura)
# Libera POST/PUT/PATCH comuns (ex.: criar prospect, inscrever em aula). Cada chamada ainda exige frase de confirmação.
EVO_ALLOW_WRITES=0
# Libera DELETE, mensagens push, controle de acesso, transferências, webhooks, funcionários. Também exige confirmação.
EVO_ALLOW_SENSITIVE=0
# Permite pedir resposta sem mascarar dados pessoais (raw: true). Deixe 0 salvo necessidade.
EVO_UNMASK=0

# Opcionais
# EVO_BASE_URL=https://evo-integracao-api.w12app.com.br
# EVO_SPEC_URL=https://evo-integracao.w12app.com.br/swagger/v1/swagger.json
